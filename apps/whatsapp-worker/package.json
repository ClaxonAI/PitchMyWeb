{
  "name": "@pitchmyweb/whatsapp-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Owns the live WhatsApp sockets: session lifecycle, encrypted auth persistence, reconnects and the outbound send queue.",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
