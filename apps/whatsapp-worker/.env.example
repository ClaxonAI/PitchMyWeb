# The worker reads this file first, then falls back to apps/api/.env, so in
# local development you only need DATABASE_URL in one place. Copy to .env
# and fill in the values you want to override.

# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every stored WhatsApp credential undecryptable and
# every linked account has to be scanned again. Never commit it.
WA_AUTH_ENCRYPTION_KEY=

# DATABASE_URL=postgresql://pitchmyweb:pitchmyweb_local@localhost:5434/pitchmyweb_dev
# REDIS_URL=redis://127.0.0.1:6381

# Outreach limits (conservative defaults shown).
# WA_MAX_PER_HOUR=20
# WA_MAX_PER_DAY=80
# WA_MIN_GAP_SECONDS=45
# WA_DUPLICATE_WINDOW_HOURS=24

# LOG_LEVEL=info
