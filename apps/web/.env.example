# --- Clerk (social sign-in) ---------------------------------------------
# Clerk's SDK reads exactly this name, for both <ClerkProvider> and
# clerkMiddleware(). Do not rename it: a differently-named variable leaves the
# middleware with an empty key, which fails the handshake in production.
# Safe to expose — the publishable key is compiled into the browser bundle by
# design. Use the pk_live_… key from your Clerk *production* instance on real
# deployments; pk_test_… keys are rate-limited and their sessions do not work
# on a production domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-side only; never exposed to the browser. Must come from the SAME Clerk
# instance as the publishable key above, and must match apps/api's
# CLERK_SECRET_KEY — otherwise sign-in dead-ends at /login.
CLERK_SECRET_KEY=

# Production only: your Clerk production instance's Frontend API domain, e.g.
# https://clerk.yourdomain.com. It is added to the Content-Security-Policy in
# next.config.ts; without it the browser blocks Clerk on your own domain.
# Development *.clerk.accounts.dev hosts are already allowed.
# CLERK_FRONTEND_API_URL=

# --- App -----------------------------------------------------------------
# Set to "production" on real deployments. next.config.ts refuses to build with
# a development Clerk key when this is set, so a dev key cannot ship by accident.
# APP_ENV=development

# Where /api/* is proxied to.
# API_URL=http://localhost:4000
