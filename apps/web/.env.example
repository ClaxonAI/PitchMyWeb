# Clerk publishable key (safe for the browser). Use the pk_live_ key in production.
CLERK_PUBLISHABLE_KEY=
# The matching secret key lives in apps/api/.env (CLERK_SECRET_KEY) and in this
# app's environment for the Clerk middleware.
CLERK_SECRET_KEY=
# Production only: your Clerk Frontend API domain (for example
# https://clerk.example.com). It is added to the Content-Security-Policy in
# next.config.ts. Development *.clerk.accounts.dev hosts are allowed already.
# CLERK_FRONTEND_API_URL=
# Where /api/* is proxied to.
# API_URL=http://localhost:4000
