# Copy to .env and fill in local values. Never commit .env.

# Matches ../docker-compose.yml (local dev only).
DATABASE_URL="postgresql://pitchmyweb:pitchmyweb_local@localhost:5434/pitchmyweb_dev"

AUTH_SECRET=
APP_URL=http://localhost:3000

# Google OAuth (optional). Create an OAuth 2.0 Client ID in Google Cloud Console
# (Web application). Authorized redirect URI must be:
#   {APP_URL}/api/auth/google/callback
# e.g. http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback


OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=

# BUSINESS_DATA_API_URL=
# BUSINESS_DATA_API_KEY=

# --- WhatsApp layer (Phase 1-2) ---------------------------------------
# Matches infrastructure/docker/docker-compose.yml. Port 6381 because 6379
# and 6380 are commonly taken by other local projects.
REDIS_URL=redis://127.0.0.1:6381

# AES-256-GCM key for the stored WhatsApp credentials, read by
# apps/whatsapp-worker. Required — the worker refuses to boot without it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it makes every stored credential undecryptable and every linked
# account has to be scanned again.
WA_AUTH_ENCRYPTION_KEY=

# --- Business discovery (apps/discovery-worker) ---------------------------
# demo = built-in fake businesses (synchronous); osm = apps/discovery-worker
# on OSM/Overpass; serper = apps/discovery-worker on Google Maps + AI
# insights (see the serper section below); python = apps/python-discovery,
# same Google Maps search, run as a separate process (run one or the other,
# never both — they consume the same queue). osm/serper/python need no extra
# config here beyond INTERNAL_JOBS_SECRET (already required below) — the
# actual search config lives in each worker's own environment. Keep this at
# demo for local dev/tests: the api test suite reads this var directly and
# expects DemoProvider's synchronous behavior, and fails in confusing,
# unrelated-looking ways under any async provider.
LEAD_PROVIDER=demo
# Runs that never report back are marked FAILED after this many minutes.
# Provider-agnostic — covers any async provider, e.g. osm/apps/discovery-worker.
ASYNC_EXECUTION_TIMEOUT_MINUTES=30

# true (default outside tests) = campaign run / scrape only after a PAID order
# is claimed onto the user. Set false to scrape without checkout locally.
REQUIRE_PAID_FOR_DISCOVERY=true

# --- apps/discovery-worker (Phase 2B: LEAD_PROVIDER=osm) -----------------
# Public instances — free but rate-limited/shared. Point these at a
# self-hosted or paid mirror before relying on osm for anything beyond
# light/dev use.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a real, identifying User-Agent.
NOMINATIM_USER_AGENT=PitchMyWeb-DiscoveryWorker/1.0 (support@pitchmyweb.com)

# --- apps/python-discovery (LEAD_PROVIDER=python) -------------------------
# Google Maps scrape in Python (Serper + optional OpenAI). Consumes the same
# business-discovery queue as apps/discovery-worker — run one worker, not both.
# SERPER_API_KEY and INTERNAL_JOBS_SECRET are required. OPENAI_API_KEY is optional.

# --- apps/discovery-worker (LEAD_PROVIDER=serper) -------------------------
# Google Maps lead discovery via serper.dev, with LangChain+OpenAI AI
# insights (business summary/services/outreach message) — the replacement
# for the old n8n "AI Lead Generation & Social Discovery" workflow. Set
# LEAD_PROVIDER=serper above AND DISCOVERY_SOURCE=serper in
# apps/discovery-worker's own environment (it reads this file too, see its
# config.ts) for both sides to agree on which search actually runs.
DISCOVERY_SOURCE=osm
SERPER_API_KEY=
# Optional — AI insights are skipped (not a hard failure) if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DISCOVERY_CONCURRENCY=1
DISCOVERY_MAX_ATTEMPTS=2
DISCOVERY_REQUEST_TIMEOUT_MS=30000
# A search stuck longer than this is failed by ASYNC_EXECUTION_TIMEOUT_MINUTES's reaper.
DISCOVERY_JOB_TIMEOUT_MS=120000

# --- apps/verification-worker (Phase 2C: rolling website-liveness check) --
# Never gates lead/campaign creation — this runs after the fact, triggered
# by a scheduler hitting POST /api/internal/jobs/enqueue-website-verifications
# (same pattern as expire-stale-runs), which enqueues one job per business
# needing a check. Needs no extra config here beyond INTERNAL_JOBS_SECRET —
# the worker's own timeouts/concurrency live in its own environment.

# --- Production hardening (lead discovery) ------------------------------
# memory (default) = per-process counts; redis = shared across API
# instances (set this in production; uses REDIS_URL). Keep memory locally:
# the test suite expects per-process counts.
RATE_LIMIT_STORE=memory
# Kill switch. true = refuse new campaign runs with 503; in-flight runs
# still receive their provider callbacks and finish.
LEAD_DISCOVERY_PAUSED=false
# Rolling 24h cap on campaign runs per user (bounds scraping spend). 0 = unlimited.
MAX_CAMPAIGN_RUNS_PER_USER_PER_DAY=20
# Bearer token schedulers send to POST /api/internal/jobs/expire-stale-runs.
# At least 24 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_JOBS_SECRET=
# Optional Slack/Discord-compatible incoming webhook for failure alerts.
ALERT_WEBHOOK_URL=
# Shown in alert messages, e.g. production / staging.
APP_ENV=development

# --- Delivery pipeline (preview sites, recordings, video sends) ---------
# Public origin of apps/sites. In production a separate domain, e.g.
# https://preview.pitchmyweb.com, so previews never share dashboard cookies.
SITES_PUBLIC_URL=http://localhost:3200
# Previews and their recordings are removed after this many days.
PREVIEW_TTL_DAYS=30
# Where apps/sites and apps/recorder-worker reach the API.
API_INTERNAL_URL=http://localhost:4000
# S3-compatible object storage. Local: MinIO (infrastructure/docker).
# Production: Cloudflare R2 / AWS S3 (set STORAGE_FORCE_PATH_STYLE=false for S3 if preferred).
STORAGE_ENDPOINT=http://127.0.0.1:9100
# Host used in signed download URLs (what a browser/phone can reach).
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9100
STORAGE_REGION=us-east-1
STORAGE_BUCKET=pitchmyweb-recordings
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
# apps/recorder-worker
RECORDER_CONCURRENCY=2
RECORDER_MAX_ATTEMPTS=2
# apps/whatsapp-worker: timeout for a single video send (upload included)
WA_SEND_MEDIA_TIMEOUT_MS=300000

# --- Checkout -----------------------------------------------------------
# dummy (default): one click marks the order PAID, no Razorpay.
# razorpay: live Standard Checkout; requires the Key ID / Secret below.
PAYMENT_GATEWAY=dummy
# From Razorpay Dashboard -> Settings -> API Keys (use Test Mode locally).
# Key ID is also echoed back to the browser by create-order (it's the public
# half of the pair); Key Secret must never reach client-side code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard -> Webhooks. Keep this different from
# the API key secret and never expose it to the browser.
RAZORPAY_WEBHOOK_SECRET=

# Clerk server verification for social sign-in -> API session bridging.
# Must come from the SAME Clerk instance as apps/web's
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY. A mismatch (one development, one
# production) makes every social sign-in fail verification and bounce the user
# back to /login; the route logs which instance this key belongs to when that
# happens. Use the sk_live_… key on real deployments.
CLERK_SECRET_KEY=

# Job scheduler (npm run jobs). Calls /api/internal/jobs/* every
# JOBS_INTERVAL_MS (default 300000 = 5 min) using INTERNAL_JOBS_SECRET.
# Required in every environment: it expires stuck searches, syncs WhatsApp
# results and re-queues failed pitches.
# JOBS_INTERVAL_MS=300000
